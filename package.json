{
  "name": "@rmartz/envctl",
  "version": "0.0.0",
  "description": "Personal gh-style CLI for managing deploy configuration and atomically rotating provider secrets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmartz/envctl.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "envctl": "dist/envctl.js"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/envctl.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ts": "vitest run",
    "check:file-length": "node scripts/check-file-length.mjs",
    "verify:release-notes": "node scripts/verify-changelog-render.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
